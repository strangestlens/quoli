{
  "name": "quoli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Quoli — the daily crossword roll",
  "scripts": {
    "dev": "vite",
    "dev:https": "QUOLI_HTTPS=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=quoli --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.123.0"
  }
}
